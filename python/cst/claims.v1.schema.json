{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        },
        "kind": {
          "default": "reference",
          "enum": [
            "reference",
            "area",
            "status",
            "unsupported"
          ],
          "title": "Kind",
          "type": "string"
        },
        "extraction": {
          "default": "manual",
          "enum": [
            "manual",
            "model",
            "producer"
          ],
          "title": "Extraction",
          "type": "string"
        },
        "generated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated By"
        }
      },
      "required": [
        "id",
        "text",
        "span",
        "refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "claims.v1",
      "default": "claims.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "original_text": {
      "title": "Original Text",
      "type": "string"
    },
    "original_text_origin": {
      "default": "full_original",
      "enum": [
        "full_original",
        "legacy_claim_texts"
      ],
      "title": "Original Text Origin",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "legacy_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legacy Reason"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "transcript_refs": {
      "items": {
        "type": "string"
      },
      "title": "Transcript Refs",
      "type": "array"
    }
  },
  "required": [
    "original_text",
    "claims"
  ],
  "title": "ClaimsDocument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geomverity:claims.v1"
}
